{
  "objects": [
    {
      "@type": "Ip",
      "description": null,
      "enable": true,
      "id": "jaat3zvqbjqa",
      "name": "STWT_RBL_SPAMHAUS_IP",
      "tag": {
        "else": "false",
        "match": {
          "0": {
            "if": "octets[0] != 127",
            "then": "false"
          },
          "1": {
            "if": "octets[3] == 2",
            "then": "if_then(location == 'tcp', 'RBL_SPAMHAUS_SBL', 'RECEIVED_SPAMHAUS_SBL')"
          },
          "2": {
            "if": "octets[3] == 3",
            "then": "if_then(location == 'tcp', 'RBL_SPAMHAUS_CSS', 'RECEIVED_SPAMHAUS_CSS')"
          },
          "3": {
            "if": "octets[3] >= 4 && octets[3] <= 7",
            "then": "if_then(location == 'tcp', 'RBL_SPAMHAUS_XBL', 'RECEIVED_SPAMHAUS_XBL')"
          },
          "4": {
            "if": "octets[3] == 9",
            "then": "if_then(location == 'tcp', 'RBL_SPAMHAUS_DROP', 'RECEIVED_SPAMHAUS_DROP')"
          },
          "5": {
            "if": "(octets[3] == 10 || octets[3] == 11)",
            "then": "if_then(location == 'tcp', 'RBL_SPAMHAUS_PBL', 'RECEIVED_SPAMHAUS_PBL')"
          },
          "6": {
            "if": "octets[3] == 254",
            "then": "if_then(location == 'tcp', 'RBL_SPAMHAUS_BLOCKED_OPENRESOLVER', 'RECEIVED_SPAMHAUS_BLOCKED_OPENRESOLVER')"
          },
          "7": {
            "if": "octets[3] == 255",
            "then": "if_then(location == 'tcp', 'RBL_SPAMHAUS_BLOCKED', 'RECEIVED_SPAMHAUS_BLOCKED')"
          }
        }
      },
      "zone": {
        "else": "ip_reverse + '.zen.spamhaus.org'",
        "match": {}
      }
    },
