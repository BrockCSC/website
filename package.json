    "clsx": "^2.1.1",
    "docx": "^9.7.2",
    "drizzle-orm": "^0.45.3",
    "heic-decode": "^2.1.0",
    "isomorphic-dompurify": "^3.22.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "oci-common": "^2.142.0",
    "oci-email": "^2.142.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0"
