# Postgres connection string for the app's database pool.
DATABASE_URL=

# Postgres schema this environment reads/writes (schema-per-environment in
# one shared database). Must match ^[a-z0-9_]+$. Defaults to "public".
DB_SCHEMA=

# Keycloak realm used for admin auth (dedicated 'brockcsc' realm, separate
# from the wayfarerbx realm).
KEYCLOAK_ISSUER=https://auth.wayfarerbx.com/realms/brockcsc
KEYCLOAK_CLIENT_ID=brockcsc-web
KEYCLOAK_CLIENT_SECRET=
# Realm role required to reach /admin. Granted on sign-up approval.
ADMIN_ROLE=executive
# Realm role for past execs: their own profile and nothing else.
ALUMNI_ROLE=alumni
# Realm role required to approve sign-ups. Bundle this with co-president.
APPROVER_ROLE=brockcsc-approver
# Realm role that satisfies every role check, including ones added later.
SUPERUSER_ROLE=owner

# Service account used to create and enable exec accounts. Needs the
# realm-management 'manage-users' role. Falls back to the login client above
# when unset, which only works if that client has service accounts enabled.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Secret used to sign our own session cookie (not the Keycloak token).
SESSION_JWT_SECRET=

# Seeds the rotating exec sign-up invite code. Changing it invalidates
# any code already handed out.
INVITE_CODE_SECRET=

# Mail. STALWART_URL is the container on wayfarer-net; the admin API is never
# exposed publicly. OCI_COMPARTMENT_OCID is the tenancy root for Email Delivery
# approved senders, reached with instance principal auth (no keys).
MAIL_DOMAIN=brockcsc.ca
STALWART_URL=http://brockcsc-stalwart:8080
STALWART_ADMIN_USER=
STALWART_ADMIN_SECRET=
OCI_COMPARTMENT_OCID=
